################################################################
# Manage solana-bridge deployment through Crypto Infrastructure as Code
################################################################

addon "svm" {
    rpc_api_url = input.rpc_api_url
    network_id = input.network_id
}

action "deploy_benfen_bridge" "svm::deploy_program" {
    description = "Deploy benfen_bridge program"
    program = svm::get_program_from_anchor_project("benfen_bridge") 
    authority = signer.authority
    payer = signer.payer
}
