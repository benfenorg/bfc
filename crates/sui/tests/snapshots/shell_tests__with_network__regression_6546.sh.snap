# fixing issue https://github.com/MystenLabs/sui/issues/6546

COIN=$(bfc client --client.config $CONFIG objects   --json | jq '.[0].data.objectId')
ADDR=$(bfc client --client.config $CONFIG addresses --json | jq '.addresses[0][1]')

bfc client --client.config $CONFIG \
  call --package 0x2 --module sui --function transfer --args $COIN $ADDR \
  --gas-budget 100000000 \
  --json | jq '.effects.status'

