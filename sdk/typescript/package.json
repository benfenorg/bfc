{
	"name": "@benfen/bfc.js",
	"author": "OpenBlock<developers@benfen.org>",
	"description": "BenFen TypeScript API(Work in Progress)",
	"version": "0.3.0",
	"license": "Apache-2.0",
	"sideEffects": false,
	"files": [
		"CHANGElOG.md",
		"LICENSE",
		"README.md",
		"bcs",
		"builder",
		"client",
		"cryptography",
		"dapp-kit",
		"dist",
		"faucet",
		"keypairs",
		"multisig",
		"src",
		"transactions",
		"utils",
		"verify",
		"wallet-kit",
		"wallet-kit-core",
		"wallet-standard",
		"zklogin"
	],
	"engines": {
		"node": ">=16"
	},
	"type": "commonjs",
	"exports": {
		"./bcs": {
			"import": "./dist/esm/bcs/index.js",
			"require": "./dist/cjs/bcs/index.js"
		},
		"./client": {
			"import": "./dist/esm/client/index.js",
			"require": "./dist/cjs/client/index.js"
		},
		"./cryptography": {
			"import": "./dist/esm/cryptography/index.js",
			"require": "./dist/cjs/cryptography/index.js"
		},
		"./faucet": {
			"import": "./dist/esm/faucet/index.js",
			"require": "./dist/cjs/faucet/index.js"
		},
		"./keypairs/ed25519": {
			"import": "./dist/esm/keypairs/ed25519/index.js",
			"require": "./dist/cjs/keypairs/ed25519/index.js"
		},
		"./keypairs/secp256k1": {
			"import": "./dist/esm/keypairs/secp256k1/index.js",
			"require": "./dist/cjs/keypairs/secp256k1/index.js"
		},
		"./keypairs/secp256r1": {
			"import": "./dist/esm/keypairs/secp256r1/index.js",
			"require": "./dist/cjs/keypairs/secp256r1/index.js"
		},
		"./multisig": {
			"import": "./dist/esm/multisig/index.js",
			"require": "./dist/cjs/multisig/index.js"
		},
		"./transactions": {
			"import": "./dist/esm/transactions/index.js",
			"require": "./dist/cjs/transactions/index.js"
		},
		"./utils": {
			"import": "./dist/esm/utils/index.js",
			"require": "./dist/cjs/utils/index.js"
		},
		"./verify": {
			"import": "./dist/esm/verify/index.js",
			"require": "./dist/cjs/verify/index.js"
		},
		"./dapp-kit": {
			"source": "./src/dapp-kit/index.ts",
			"import": "./dist/esm/dapp-kit/index.js",
			"require": "./dist/cjs/dapp-kit/index.js"
		},
		"./wallet-standard": {
			"source": "./src/wallet-standard/index.ts",
			"import": "./dist/esm/wallet-standard/index.js",
			"require": "./dist/cjs/wallet-standard/index.js"
		},
		"./zklogin": {
			"source": "./src/zklogin/index.ts",
			"import": "./dist/esm/zklogin/index.js",
			"require": "./dist/cjs/zklogin/index.js"
		}
	},
	"scripts": {
		"clean": "rm -rf tsconfig.tsbuildinfo ./dist",
		"codegen:version": "node genversion.mjs",
		"build": "node genversion.mjs && pnpm build:package",
		"build:package": "build-package",
		"vitest": "vitest",
		"test": "pnpm test:typecheck && pnpm test:unit",
		"test:typecheck": "tsc -p ./test",
		"test:unit": "vitest run unit __tests__",
		"test:dapp-kit:unit": "vitest run -c ./src/dapp-kit/vitest.config.ts",
		"prepublishOnly": "pnpm build",
		"size": "size-limit",
		"analyze": "size-limit --why",
		"prettier:check": "prettier -c --ignore-unknown .",
		"prettier:fix": "prettier -w --ignore-unknown .",
		"eslint:check": "eslint --max-warnings=0 .",
		"eslint:fix": "pnpm run eslint:check --fix",
		"lint": "pnpm run eslint:check && pnpm run prettier:check",
		"lint:fix": "pnpm run eslint:fix && pnpm run prettier:fix"
	},
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"@benfen/build-scripts": "workspace:*",
		"@iarna/toml": "^2.2.5",
		"@size-limit/preset-small-lib": "^8.2.6",
		"@testing-library/dom": "^9.3.1",
		"@testing-library/jest-dom": "^5.17.0",
		"@testing-library/react": "^14.0.0",
		"@testing-library/user-event": "^14.4.3",
		"@types/jest": "^29.5.12",
		"@types/node": "^20.4.2",
		"@types/react": "^18.2.15",
		"@types/testing-library__jest-dom": "^5.14.9",
		"@types/tmp": "^0.2.3",
		"@types/ws": "^8.5.9",
		"@vanilla-extract/vite-plugin": "^4.0.11",
		"cross-env": "^7.0.3",
		"jsdom": "^24.1.0",
		"react": "^18.2.0",
		"size-limit": "^8.2.6",
		"tmp": "^0.2.1",
		"typescript": "^5.7.2",
		"vite": "^6.0.7",
		"vitest": "^2.1.8"
	},
	"dependencies": {
		"@noble/curves": "^1.4.2",
		"@noble/hashes": "^1.4.0",
		"@scure/base": "^1.2.4",
		"@scure/bip32": "^1.3.1",
		"@scure/bip39": "^1.2.1",
		"@vanilla-extract/css": "^1.15.3",
		"@vanilla-extract/dynamic": "^2.1.1",
		"@vanilla-extract/recipes": "^0.5.3",
		"@wallet-standard/core": "^1.0.3",
		"bech32": "^2.0.0",
		"bignumber.js": "^9.1.1",
		"bs58": "^5.0.0",
		"clsx": "^2.0.0",
		"events": "^3.3.0",
		"fast-sha256": "^1.3.0",
		"jose": "^5.4.1",
		"poseidon-lite": "^0.2.0",
		"valibot": "^0.36.0",
		"zustand": "^4.4.1"
	},
	"peerDependencies": {
		"@tanstack/react-query": "*",
		"react": "*"
	}
}
